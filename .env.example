# Copy to .env for local development (.env is gitignored — never commit real secrets).
# server.py reads these directly from the environment; a .env file is only loaded if you
# source it yourself or use a tool like `python-dotenv` / `honcho` / your shell's `export`.

# Port the HTTP server binds to (0.0.0.0).
PORT=8080

# "1" includes rule names, matched text, and judge reasoning in /check responses (dev).
# "0" hides them from callers in production, per bankguard.Config(verbose=...).
BANKGUARD_VERBOSE=1

# Optional. When set (and `pip install anthropic` is available — see requirements.txt),
# server.py builds a real ClaudeJudge and runs the hybrid rules+LLM pipeline. When unset,
# the firewall runs rules-only and /health reports {"pipeline": "rules_only"}.
ANTHROPIC_API_KEY=

# Max POST /check requests per client IP per 60-second window before the server returns 429.
RATE_LIMIT_PER_MIN=30
