# Copy to .env for local development (.env is gitignored — never commit real secrets).
# Loaded by bankguard/envfile.py's load_dotenv() at process start (server.py / api/*.py /
# evals/run_evals.py), with one rule: an already-set environment variable always wins over
# this file, so a real deployment's dashboard env vars are never shadowed by a stray .env.

# Port the local dev server (server.py) binds to (0.0.0.0). Vercel sets its own port; this
# var is ignored there.
PORT=8080

# "1" includes rule names, matched text, and judge reasoning in /check responses (dev).
# "0" hides them from callers in production, per bankguard.Config(verbose=...).
BANKGUARD_VERBOSE=1

# Which LLM judge provider to use: "gemini" (default) or "none" (rules-only, no judge at
# all regardless of any key below). See bankguard/judge.py.
LLM_PROVIDER=gemini

# Required for LLM_PROVIDER=gemini. Get one at https://aistudio.google.com/apikey (Google AI
# Studio). Never printed or logged by this codebase.
GEMINI_API_KEY=

# Gemini model id. gemini-flash-lite-latest was verified against the live API while building
# this: ~1.3-2.3s per call under normal load (gemini-2.5-flash returned 404 "no longer
# available to new users" as of this writing — Google deprecates model ids over time, so
# re-check https://ai.google.dev/gemini-api/docs/models before deploying). The judge's total
# timeout budget is 7s across one attempt + one retry (bankguard/providers/gemini.py), which
# still occasionally fails closed under sustained API load — see evals/RESULTS.md's note on
# the eval run that hit this.
GEMINI_MODEL=gemini-flash-lite-latest

# Max POST /check requests per client IP per 60-second window before the server returns 429.
# Best-effort / in-memory / per-process — see docs/DEPLOY.md for what that means on Vercel.
RATE_LIMIT_PER_MIN=30
